# Voice agent image — heavier (Pipecat + Deepgram + audio deps). Kept separate from
# the core api image so the REST demo builds fast. Pin to 3.12 for wheel coverage.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

# System libs for audio / soundfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg espeak-ng \
    && rm -rf /var/lib/apt/lists/*

# Heavy layer — PINNED to the versions proven in production. Unpinned `>=` let
# pip pull a newer Pipecat/OpenAI on the box than local, which broke the Twilio
# telephony path (add_wav_header / reasoning_format). Pin so local == prod.
RUN pip install --no-cache-dir \
        "httpx>=0.27" "pydantic-settings>=2.3" "python-dotenv>=1.0" \
        "pipecat-ai[groq,webrtc,silero,deepgram]==1.8.1" "openai==2.54.0" \
        "soundfile>=0.12" "numpy>=1.26"

# Light layer — runner web server + SmallWebRTC prebuilt UI.
# Separate from the heavy layer so these edits don't re-pull torch.
RUN pip install --no-cache-dir \
        "fastapi>=0.115" "uvicorn[standard]>=0.30" "pydantic>=2.7" \
        "pipecat-ai-prebuilt"

# Pre-bake NLTK's punkt_tab sentence-tokenizer data into the image. Pipecat's
# PipelineWorker._setup awaits warm_deferred_imports (→ _sent_tokenizer), which
# downloads punkt_tab on first use. On a fresh container that download runs on
# the FIRST browser connect and, on a cold network, can exceed the 20s pipeline
# SETUP_TIMEOUT_SECS — the setup times out and the bot never greets. Baking the
# data at build time makes the tokenizer load from disk, so setup never waits on
# the network. (Also warms it under the same NLTK path the runtime uses.)
RUN python -m nltk.downloader -d /root/nltk_data punkt_tab punkt

COPY app ./app
COPY web ./web

EXPOSE 7860
# The runner serves the WebRTC UI on :7860 and dispatches to bot() per connection.
CMD ["python", "-m", "app.agent.pipeline", "-t", "webrtc", "--host", "0.0.0.0"]
