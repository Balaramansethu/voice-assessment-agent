# --- app ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://interview:interview@postgres:5432/interview

# Required for docker-compose.prod.yml — the production Postgres container and the
# api service's DATABASE_URL are both built from these. Use real, rotated credentials
# in production; never reuse the local dev defaults.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=interview

# --- transport ---
TRANSPORT_PROVIDER=webrtc          # webrtc | twilio

# --- inference: Groq LLM + Deepgram STT/TTS ---
STT_PROVIDER=deepgram              # deepgram
LLM_PROVIDER=groq                  # groq | ollama
TTS_PROVIDER=deepgram              # deepgram
GROQ_API_KEY=                      # paste your gsk_ key from console.groq.com
GROQ_LLM_MODEL=qwen/qwen3.8-27b          # conversational voice model (clean streaming, no reasoning leak)
GROQ_GRADER_MODEL=openai/gpt-oss-120b    # silent grader (reasoning ok; never spoken)

# --- Deepgram: streaming STT (Nova) + TTS (Aura) ---
DEEPGRAM_API_KEY=                  # paste your key from console.deepgram.com
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# --- end-of-turn detection (agent) ---
TURN_DETECTION=smart_turn          # smart_turn (ML prosody EOT, primary decider) | vad (fixed-silence fallback)
SMART_TURN_CPU_COUNT=2             # ONNX inference threads for Smart Turn v3
SMART_TURN_STOP_SECS=2.0           # hard-silence SAFETY NET for a stuck turn only (Smart Turn decides; analyzer default 3.0)
INTERRUPTION_MIN_WORDS=3           # words the caller must speak to barge in while the bot is talking (noise/echo won't)

# --- offline fallback (optional; needs capable hardware) ---
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1:8b
WHISPER_MODEL=small

# --- optional PSTN (leave blank for browser-only demo) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_HOST=your-subdomain.duckdns.org

# --- PR-105 — scope shared-secret keys (rotate independently per scope in production) ---
AGENT_SHARED_KEY=dev-agent-key-change-me
RECRUITER_SHARED_KEY=dev-recruiter-key-change-me
WORKER_SHARED_KEY=dev-worker-key-change-me
OPS_SHARED_KEY=dev-ops-key-change-me

# --- PR-021 — public voice-entry hardening (safe defaults, override only if needed) ---
VOICE_SESSION_TOKEN_TTL_SECONDS=30
MAX_CONCURRENT_CALLS=5
MAX_CALLS_PER_NUMBER_PER_MINUTE=3
MAX_CALL_DURATION_SECONDS=900
MAX_INACTIVITY_SECONDS=120            # force-end a call after this many seconds of silence from both parties (PR-407)

# demo: which seeded caller the browser agent resolves as
DEMO_CALLER_PHONE=+919000000001
